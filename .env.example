# --- Groq Reasoning Engine ---
GROQ_API_KEY = ""
GROQ_FALLBACK_API_KEY = ""
GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL = "openai/gpt-oss-20b"

# --- Portkey LLM Gateway (optional; leave empty to call Groq directly) ---
PORTKEY_API_KEY = ""

# --- Qdrant Vector DB (Cloud) ---
# API key is the long JWT token from the Qdrant Cloud dashboard (NOT the cluster UUID).
QDRANT_API_KEY = ""
QDRANT_CLUSTER_ENDPOINT = ""

# --- Gemini Embeddings (3072-dim) ---
GEMINI_API_KEY = ""

# === Observability ===

# Pydantic Logfire (leave empty to disable remote sending / use CLI login)
LOGFIRE_TOKEN = ""

# LangSmith (optional)
LANGSMITH_TRACING = "true"
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = "enterprise_rag"

# === Service wiring ===

# URL the Streamlit UI uses to reach the FastAPI backend
BACKEND_URL = "http://localhost:8000"

# Dedicated Groq key for the RAGAS eval judge (defaults to GROQ_API_KEY)
JUDGE_GROQ = ""
